{
  "name": "trend-getter",
  "version": "1.0.0",
  "description": "Busca as trends do X (Twitter) duas vezes por dia e destaca as que combinam com os seus interesses.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/main.js",
    "dev": "node --watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/main.js",
    "collect": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/collect.js",
    "build:site": "node --env-file-if-exists=.env src/build-site.js",
    "test": "node --test --disable-warning=ExperimentalWarning"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0"
  }
}
